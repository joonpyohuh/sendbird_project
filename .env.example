# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and is read only on the server.

# Required: your OpenAI API key (server-side only, never exposed to the client).
OPENAI_API_KEY=sk-your-key-here

# Optional: override the model. Defaults to gpt-4o-mini in code if unset.
OPENAI_MODEL=gpt-4o-mini
